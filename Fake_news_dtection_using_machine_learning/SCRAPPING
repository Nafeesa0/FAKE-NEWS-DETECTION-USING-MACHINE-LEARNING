# Import the requests library to send HTTP requests to websites
import requests

# Import BeautifulSoup to parse HTML content
from bs4 import BeautifulSoup

# URL of the website we want to scrape
url = "https://www.thehindu.com/latest-news/"

# Send a GET request to the website
response = requests.get(url)

# Check if the request was successful
print(response.status_code)

# Get the HTML content of the webpage
html_content = response.text

# Parse the HTML using BeautifulSoup
soup = BeautifulSoup(html_content, "html.parser")

# Find all headline tags (h3 tags usually contain news titles)
headlines = soup.find_all("h3")

# Loop through each headline and print the text
for headline in headlines:
    title = headline.get_text(strip=True)
    print(title)
